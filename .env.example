# =====================================================================
# R2D2 example environment file.
# Copy to .env for *non-secret* defaults. SECRETS DO NOT BELONG HERE.
# Use ./run.sh (which reads from `pass`) for:
#   r2d2/jwt-secret        (auto-generated)
#   r2d2/encryption-key    (auto-generated, Fernet)
#   r2d2/searxng-secret    (auto-generated)
#   r2d2/tavily            (you `pass insert`; optional)
#   r2d2/brave             (you `pass insert`; optional)
# See run.sh for the one-time setup.
# =====================================================================

# ---- Engine -----------------------------------------------------------
# OLLAMA_URL=http://ollama:11434           # default; falls back to host.docker.internal

# ---- Web search -------------------------------------------------------
# Bundled self-hosted SearXNG; override only if you point at a different instance.
# SEARXNG_URL=http://searxng:8080
# DEFAULT_SEARCH_PROVIDER=searxng          # tavily | searxng | brave | duckduckgo

# ---- Cookie / TLS -----------------------------------------------------
# This stack ships with Caddy terminating HTTPS on https://r2d2.localhost.
# Keep COOKIE_SECURE=1 unless you intentionally serve plain HTTP.
COOKIE_SECURE=1

# ---- Branding overrides (single source of truth: branding.toml) ------
# See branding.toml for the full key list. Uncomment to override without
# editing the TOML.
# BRAND_PRODUCT_NAME=R2D2
# BRAND_ASSISTANT_NAME=R2D2
# BRAND_PRIMARY=#0a84ff
# BRAND_ACCENT=#34c759
