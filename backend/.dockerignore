# Build context exclusions for `docker build ./backend`.
# Keep the image small and avoid leaking dev artifacts.

# VCS / IDE
.git
.gitignore
.gitattributes
.vscode
.idea

# Python build / cache
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Virtualenvs
.venv/
venv/
env/

# Local data — must NEVER bake into the image
.data/
data/
uploads/

# Tests are not needed in the runtime image
tests/

# Alembic working files
alembic/__pycache__/

# Editor / OS
.DS_Store
Thumbs.db
*.swp
